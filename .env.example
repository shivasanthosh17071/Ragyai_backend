# ---------- Core ----------
NODE_ENV=development
PORT=5000
BRAND_NAME=RAGYAI_m
API_BASE_URL=http://localhost:5000
# Comma separated list of allowed browser origins (storefront + admin app).
# In production this MUST include your real deployed frontend origin(s)
# (e.g. https://your-app.vercel.app) or every browser request — including
# register/login — will be rejected by CORS.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# Canonical frontend URL used to build links in emails (verification, password reset).
# Defaults to the first CLIENT_ORIGINS entry if unset — set explicitly so email links
# don't depend on how CLIENT_ORIGINS happens to be ordered.
APP_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://localhost:27017/ragyai_m

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=brand-store
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RAGYAI_m <no-reply@example.com>"
ADMIN_ALERT_EMAIL=owner@example.com

# ---------- SMS / OTP provider ----------
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
OTP_TTL_MINUTES=10

# ---------- Store rules ----------
DEFAULT_SHIPPING_FEE=59
FREE_SHIPPING_THRESHOLD=999
TAX_PERCENT=0
LOW_STOCK_THRESHOLD=5
COD_CONFIRM_WINDOW_HOURS=24

# ---------- Shiprocket (phase 2) ----------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
